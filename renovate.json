{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>MrNoname3/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The validator's image version in scripts/check.sh, under a '# renovate: datasource=... depName=...' comment",
      "managerFilePatterns": [
        "/^scripts/check\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\w+=(?<currentValue>\\S+)"
      ]
    }
  ]
}
